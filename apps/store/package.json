{
  "name": "@bitgames/store",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/vendor.ts && vite dev --port 3030 --strictPort",
    "build": "node scripts/vendor.ts && vite build",
    "deploy": "node scripts/vendor.ts && cf deploy",
    "cf-typegen": "cf workers types",
    "typecheck": "cf workers types >/dev/null && tsc --noEmit",
    "db:migrate": "node scripts/db.ts migrate",
    "db:migrate:remote": "node scripts/db.ts migrate --remote",
    "seed": "node scripts/db.ts seed",
    "seed:remote": "node scripts/db.ts seed --remote",
    "test": "node --test scripts/*.test.ts"
  },
  "dependencies": {
    "@bitgames/game-sdk": "workspace:*",
    "@bitgames/webrtc": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-db-collection": "^1.3.1",
    "@tanstack/react-db": "^0.5.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "^1.0.0-beta.12",
    "esbuild": "0.28.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
