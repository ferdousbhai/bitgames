{
  "name": "@bitgames/store",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3030 --strictPort",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply bitgames --local",
    "db:migrate:remote": "wrangler d1 migrations apply bitgames --remote",
    "seed": "node scripts/seed.ts --local",
    "seed:remote": "node scripts/seed.ts --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-db-collection": "^1.3.1",
    "@tanstack/react-db": "^0.5.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.147.0"
  }
}
