# BitGames plays the game in a sandboxed frame with no origin of its own, and
# locks down what it may load: only the game's own files and BitGames' shared
# libraries. The Content-Security-Policy enforces that in every browser (BitGames
# checks it when a version is submitted); Allow-CSP-From lets the frame apply the
# same rules; CORS lets the sandboxed page load the game's own scripts and models.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://bitgames.store/vendor/ 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://bitgames.store/vendor/ data: blob:; worker-src 'self' blob:; base-uri 'none'; form-action 'none'
  Allow-CSP-From: *
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
